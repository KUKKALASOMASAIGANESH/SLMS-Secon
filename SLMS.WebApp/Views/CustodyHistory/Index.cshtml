@model IEnumerable<SLMS.WebApp.Models.CustodyHistoryViewModel>

@{
    ViewData["Title"] = "Custody History";
}

<div class="card shadow-sm">

    <div class="card-body">

        <div class="d-flex justify-content-between mb-3">
            <h2>Custody History</h2>

            <a asp-action="Create"
               class="btn btn-primary">
                Add Custody
            </a>
        </div>

        <form asp-action="SearchByInventory"
              method="get"
              class="mb-3">

            <div class="row">

                <div class="col-md-4">
                    <input name="inventoryItemId"
                           class="form-control"
                           placeholder="Inventory Item Id" />
                </div>

                <div class="col-md-2">
                    <button type="submit"
                            class="btn btn-primary">
                        Search
                    </button>
                </div>

            </div>

        </form>

        <table class="table table-bordered table-striped table-hover">

            <thead>
                <tr>
                    <th>Inventory Item</th>
                    <th>From Department</th>
                    <th>To Department</th>
                    <th>Transfer Date</th>
                    <th>Reason</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.InventoryItemId</td>
                        <td>@item.FromDepartmentId</td>
                        <td>@item.ToDepartmentId</td>
                        <td>@item.TransferDate.ToString("dd-MMM-yyyy")</td>
                        <td>@item.TransferReason</td>

                        <td>
                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-info btn-sm">
                                Details
                            </a>

                            <a asp-action="CurrentCustodian"
                               asp-route-inventoryItemId="@item.InventoryItemId"
                               class="btn btn-success btn-sm">
                                Current
                            </a>
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>