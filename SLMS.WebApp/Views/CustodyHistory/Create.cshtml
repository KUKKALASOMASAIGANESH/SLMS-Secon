@model SLMS.WebApp.Models.CustodyHistoryViewModel

@{
    ViewData["Title"] = "Create Custody";
}

<div class="card shadow-sm">

    <div class="card-body">

        <h2>Create Custody</h2>

        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>

            <div class="mb-3">
                <label asp-for="InventoryItemId"></label>
                <input asp-for="InventoryItemId"
                       class="form-control"
                       tabindex="1" />
                <span asp-validation-for="InventoryItemId"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FromDepartmentId"></label>
                <input asp-for="FromDepartmentId"
                       class="form-control"
                       tabindex="2" />
                <span asp-validation-for="FromDepartmentId"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ToDepartmentId"></label>
                <input asp-for="ToDepartmentId"
                       class="form-control"
                       tabindex="3" />
                <span asp-validation-for="ToDepartmentId"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TransferReason"></label>
                <input asp-for="TransferReason"
                       class="form-control"
                       tabindex="4" />
                <span asp-validation-for="TransferReason"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Remarks"></label>
                <input asp-for="Remarks"
                       class="form-control"
                       tabindex="5" />
                <span asp-validation-for="Remarks"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TransferredByUserId"></label>
                <input asp-for="TransferredByUserId"
                       class="form-control"
                       tabindex="6" />
                <span asp-validation-for="TransferredByUserId"
                      class="text-danger"></span>
            </div>

            <button type="submit"
                    class="btn btn-success"
                    tabindex="7">
                Save
            </button>

            <a asp-action="Index"
               class="btn btn-secondary"
               tabindex="8">
                Cancel
            </a>

        </form>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}