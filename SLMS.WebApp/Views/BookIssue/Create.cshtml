@model SLMS.WebApp.Models.BookIssueViewModel

@{
    ViewData["Title"] = "Issue Book";
}

<div class="card shadow-sm">
    <div class="card-body">

        <h3>Issue Book</h3>
        <hr />

        <form asp-action="Create" method="post">

            <div class="mb-3">
                <label>Book Title</label>

                <select asp-for="LibraryResourceId"
                        asp-items="Model.BookList"
                        class="form-control">

                    <option value="">
                        Select Book
                    </option>

                </select>
            </div>

            <div class="mb-3">
                <label>Employee No / Employee Name</label>

                <select asp-for="EmployeeId"
                        asp-items="Model.EmployeeList"
                        class="form-control">

                    <option value="">
                        Select Employee
                    </option>

                </select>
            </div>

            <div class="mb-3">
                <label>Issue Date</label>

                <input asp-for="IssueDate"
                       type="date"
                       class="form-control" />
            </div>

            <div class="mb-3">
                <label>Due Date</label>

                <input asp-for="DueDate"
                       type="date"
                       class="form-control" />
            </div>

            <div class="mb-3">
                <label>Status</label>

                <input asp-for="Status"
                       class="form-control"/>
            </div>

            <button type="submit"
                    class="btn btn-primary">
                Issue Book
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>
</div>