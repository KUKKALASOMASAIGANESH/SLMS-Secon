                                            <a class="dropdown-item"
                                               asp-controller="Shelf"
                                               asp-action="Index">Shelf Management</a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="LibraryResource"
                                               asp-action="Index">Library Resources</a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="BookIssue"
                                               asp-action="Index">Book Issues</a>
                                        </li>

                                    </ul>

                                </li>

                                <li class="nav-item dropdown">

                                    <a class="nav-link dropdown-toggle"
                                       href="#"
                                       data-bs-toggle="dropdown">

                                        Transactions

                                    </a>

                                    <ul class="dropdown-menu">

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Transaction"
                                               asp-action="Dashboard">Dashboard</a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Transaction"
                                               asp-action="ReturnBook">Return Book</a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Transaction"
                                               asp-action="Requests">Request Approvals</a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Transaction"
                                               asp-action="OverdueBooks">Overdue Books</a>
                                        </li>

                                    </ul>

                                </li>

                                <li class="nav-item dropdown">

                                    <a class="nav-link dropdown-toggle"
                                       href="#"
                                       data-bs-toggle="dropdown">

                                        Digital Library

                                    </a>

                                    <ul class="dropdown-menu">

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="DigitalLibrary"
                                               asp-action="Index">Digital Library</a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="DigitalLibrary"
                                               asp-action="ManageContent">Manage Content</a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="DigitalLibrary"
                                               asp-action="ManageRequests">Manage Requests</a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="DigitalLibrary"
                                               asp-action="ManagePolicies">Manage Policies</a>
                                        </li>

                                    </ul>

                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="CustodyHistory"
                                       asp-action="Index">
                                        Custody History
                                    </a>
                                </li>

                                <li class="nav-item">
