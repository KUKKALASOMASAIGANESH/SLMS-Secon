                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Reports"
                                       asp-action="Index">
                                        Reports
                                    </a>
                                </li>
                            }

                            <!-- ================= USER ================= -->
                            @if (User.IsInRole("User"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle"
                                       href="#"
                                       data-bs-toggle="dropdown">
                                        Transactions
                                    </a>

                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Transaction"
                                               asp-action="ReturnBook">
                                                Return Book
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Transaction"
                                               asp-action="OverdueBooks">
                                                Overdue Books
                                            </a>
                                        </li>
                                    </ul>
                                </li>

                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle"
                                       href="#"
                                       data-bs-toggle="dropdown">
                                        Digital Library
                                    </a>

                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="DigitalLibrary"
                                               asp-action="Index">
                                                Digital Library
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="DigitalLibrary"
                                               asp-action="MyRequests">
                                                My Requests
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }

                            <!-- User Name -->

                            <li class="nav-item">
                                <span class="nav-link">
                                    Welcome @User.Identity.Name
                                </span>
                            </li>

                            <!-- Logout -->

                            <li class="nav-item">
                                <a class="nav-link text-danger"
                                   asp-controller="Auth"
                                   asp-action="Logout">
                                    Logout
                                </a>
                            </li>
                        }

                    </ul>

                </div>

            </div>

        </nav>

    </header>

    <div class="container-fluid px-4">

        <main role="main" class="pb-3">

            @RenderBody()

        </main>

    </div>

    <footer class="border-top  text-center text-muted mt-4 fixed-bottom">

        <div class="container-fluid px-4">

            &copy; 2026 - SECON Library Management System

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>