<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SLMS</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/SLMS.WebApp.styles.css"
          asp-append-version="true" />
</head>

<script>
    setTimeout(function () {

        var alerts =
            document.querySelectorAll('.alert');

        alerts.forEach(function (alert) {

            alert.style.transition = "opacity 0.5s";

            alert.style.opacity = "0";

            setTimeout(function () {
                alert.remove();
            }, 500);

        });

    }, 3000);
</script>

<body>

    <header>

        <nav class="navbar navbar-expand-lg navbar-dark mb-3">

            <div class="container-fluid">

                <a class="navbar-brand d-flex align-items-center"
                   asp-controller="Home"
                   asp-action="Index">

                    <img src="~/images/secon-logo.jpg"
                         alt="SECON Logo"
                         style="height:50px;width:auto;margin-right:10px;"
                         onerror="this.style.display='none'" />

                    <div>
                        <div style="font-weight:bold;">
                            SECON
                        </div>

                        <small>
                            Library Management System
                        </small>
                    </div>

                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarContent">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse"
                     id="navbarContent">

                    <ul class="navbar-nav ms-auto">

                        

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Shelf"
                               asp-action="Index">
                                Shelf Management
                            </a>
                        </li>

                        @* <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Inventory"
                               asp-action="Dashboard">
                                Inventory Dashboard
                            </a>
                        </li> *@

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Category"
                               asp-action="Index">
                                Categories
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="LibraryResource"
                               asp-action="Index">
                                Library Resources
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="BookIssue"
                               asp-action="Index">
                                Book Issues
                            </a>
                        </li>

                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown">

                                Transactions

                            </a>

                            <ul class="dropdown-menu">

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Transaction"
                                       asp-action="Dashboard">
                                        Dashboard
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Transaction"
                                       asp-action="ReturnBook">
                                        Return Book
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Transaction"
                                       asp-action="Requests">
                                        Request Approvals
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Transaction"
                                       asp-action="OverdueBooks">
                                        Overdue Books
                                    </a>
                                </li>

                            </ul>

                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="DigitalLibrary"
                               asp-action="Index">
                                Digital Library
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="DigitalLibrary"
                               asp-action="ManageContent">
                                Manage Content
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="DigitalLibrary"
                               asp-action="ManageRequests">
                                Manage Requests
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="DigitalLibrary"
                               asp-action="ManagePolicies">
                                Manage Policies
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Employee"
                               asp-action="Index">
                                Employees
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="CustodyHistory"
                               asp-action="Index">
                                Custody History
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="AuditLog"
                               asp-action="Index">
                                Audit Logs
                            </a>
                        </li>
                       

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="UserManagement"
                                       asp-action="Index">
                                        User Management
                                    </a>
                                </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Department"
                               asp-action="Index">
                                Departments
                            </a>
                        </li>

                        <!-- ✅ ADDED REPORTS (ONLY ADDITION, NOTHING CHANGED) -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Reports"
                               asp-action="Index">
                                Reports
                            </a>
                        </li>
                        <li class="nav-item">
                            <span class="nav-link">
                                @User.Identity?.Name
                            </span>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-danger"
                               asp-controller="Auth"
                               asp-action="Logout">
                                Logout
                            </a>
                        </li>


                    </ul>

                </div>

            </div>

        </nav>

    </header>

    <div class="container-fluid px-4">

        <main role="main" class="pb-3">

            @RenderBody()

        </main>

    </div>

    <footer class="border-top  text-center text-muted mt-4 fixed-bottom">

        <div class="container-fluid px-4">

            &copy; 2026 - SECON | Smart Library Management System

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>