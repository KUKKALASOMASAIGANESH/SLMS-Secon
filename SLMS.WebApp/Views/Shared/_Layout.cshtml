                                            <a class="dropdown-item"
                                               asp-controller="DigitalLibrary"
                                               asp-action="Index">Digital Library</a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="DigitalLibrary"
                                               asp-action="ManageContent">Manage Content</a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="DigitalLibrary"
                                               asp-action="ManageRequests">Manage Requests</a>
