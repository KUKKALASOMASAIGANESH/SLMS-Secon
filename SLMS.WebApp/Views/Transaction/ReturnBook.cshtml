@model SLMS.Shared.DTOs.BookReturn.BookReturnCreateDto
@using SLMS.Shared.DTOs.BookIssue

@{
    var issuedBooks =
        ViewBag.IssuedBooks as List<BookIssueResponseDto>
        ?? new List<BookIssueResponseDto>();
}

<form asp-action="ReturnBook" method="post">

    <div class="mb-3">
        <label asp-for="BookIssueId" class="form-label">Issued Book</label>

        <select asp-for="BookIssueId" class="form-control">
            <option value="">-- Select Book --</option>

            @foreach (var book in issuedBooks)
            {
                <option value="@book.Id">
                    @book.BookTitle
                </option>
            }
        </select>

        <span asp-validation-for="BookIssueId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ReturnDate" class="form-label"></label>
        <input asp-for="ReturnDate" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Condition" class="form-label"></label>
        <input asp-for="Condition" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Remarks" class="form-label"></label>
        <textarea asp-for="Remarks" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="FineAmount" class="form-label"></label>
        <input asp-for="FineAmount" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">
        Return Book
    </button>

</form>