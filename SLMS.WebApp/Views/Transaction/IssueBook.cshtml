@model SLMS.Shared.DTOs.BookIssue.BookIssueCreateDto

<h2>Issue Book</h2>

<form method="post">

    <div class="mb-3">
        <label>Inventory Item Id</label>
        <input asp-for="LibraryResourceId"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Employee Id</label>
        <input asp-for="EmployeeId"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Issued By User</label>
        <input asp-for="IssuedByUserId"
               class="form-control" />
    </div>

    <button type="submit"
            class="btn btn-primary">
        Issue Book
    </button>

</form>