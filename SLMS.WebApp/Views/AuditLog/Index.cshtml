@model IEnumerable<SLMS.WebApp.Models.AuditLogViewModel>

@{
    ViewData["Title"] = "Audit Logs";
}
<div class="card shadow-sm">
    <div class="card-body">
nxt

<h2>Audit Logs</h2>


<table class="table table-bordered table-striped">

    <thead>
        <tr>
            <th>User Id</th>
            <th>Module</th>
            <th>Action</th>
            <th>IP Address</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.UserId</td>
                <td>@item.Module</td>
                <td>@item.Action</td>
                <td>@item.IPAddress</td>

                <td>
                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-info btn-sm">
                        Details
                    </a>
                </td>
            </tr>
        }

    </tbody>

</table>
</div>
</div>