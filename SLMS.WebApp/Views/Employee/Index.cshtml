@model IEnumerable<SLMS.WebApp.Models.EmployeeViewModel>

@{
    ViewData["Title"] = "Employees";
}
<div class="card shadow-sm">
    <div class="card-body">

<div class="d-flex justify-content-between mb-3">
    <h2>Employee Management</h2>

    <a asp-action="Create"
       class="btn btn-primary">
        Add Employee
    </a>
</div>
<form asp-action="Search"
      method="get"
      class="mb-3">

    <div class="row">

        <div class="col-md-4">
            <input name="name"
                   class="form-control"
                   placeholder="Search Employee Name" />
        </div>

        <div class="col-md-2">
            <button type="submit"
                    class="btn btn-primary">
                Search
            </button>
        </div>

        <div class="col-md-2">
            <a asp-action="Index"
               class="btn btn-secondary">
                Clear
            </a>
        </div>

    </div>

</form>
<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Employee No</th>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Designation</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.EmployeeNumber</td>
                <td>@item.FullName</td>
                <td>@item.Email</td>
                <td>@item.Phone</td>
                <td>@item.Designation</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <form asp-action="Delete"
                          asp-route-id="@item.Id"
                          method="post"
                          style="display:inline">

                        <button type="submit"
                                class="btn btn-danger btn-sm">
                            Delete
                        </button>

                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
    </div>
</div>